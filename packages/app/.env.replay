# =============================================================================
# .env.replay — loaded only by `vite --mode replay` (pnpm playtest:replay).
# The no-backend playtest: the app is pointed at an address NOTHING listens on
# (the same dead port the e2e stub lanes use, e2e/helpers/e2eOrigins.ts), and
# src/dev/playtestTraffic.ts answers every request from a saved scenario. A
# request replay does not answer fails as a connection refusal — it can never
# reach a real project. The key is a placeholder; nothing checks it.
# The host's first label ("127") keeps supabase-js's session key the same as
# the local stack's, so a recorded session drops straight in.
# =============================================================================
VITE_SUPABASE_URL=http://127.0.0.1:54399
VITE_SUPABASE_ANON_KEY=replay-no-backend
VITE_DISTRICT_HINT=
