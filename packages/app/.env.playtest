# =============================================================================
# .env.playtest — loaded only by `vite --mode playtest` (pnpm playtest).
# Points the app at the LOCAL Supabase stack. Both values are the CLI's
# public, well-known local demo values (not secrets; identical on every
# machine unless a custom JWT secret is configured). scripts/playtest.mjs
# refuses to start if they disagree with `supabase status`.
# Vite gives this file priority over .env.local, so the live project is never
# reachable in this mode.
# =============================================================================
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# No district hint: the playtest accounts are email + password.
VITE_DISTRICT_HINT=
