# Copy to .env (gitignored) and fill in. Environment variables override.

# The platform — same values the app uses (Settings -> API in the dashboard,
# or the local stack's `supabase status` output). The ANON/publishable key:
# the worker signs in as the TEACHER (worker:login) and never holds a
# service key (D3).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The local inference server (vLLM, OpenAI-compatible). W-6: vLLM guided
# decoding is the pilot's named mechanism; verify any server with
# `pnpm worker:check` before trusting it.
INFERENCE_URL=http://127.0.0.1:8000/v1

# The model id the server exposes. Must have an E2b golden run in
# golden-log.json (W-7) or run under --allow-unvalidated.
#MODEL_ID=qwen3-32b

# Tuning (defaults shown; clamped server-side too).
#BATCH_SIZE=4
#LEASE_MINUTES=15
#POLL_SECONDS=30

# Only for study:report / telemetry:edit-rates (direct SQL reads).
#GRADING_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
